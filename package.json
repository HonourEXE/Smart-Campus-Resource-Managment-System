{
  "name": "smart-campus-and-resource-management-system",
  "version": "1.0.0",
  "description": "Smart Campus and Resource Management System (SCRMS) with Real-Time Availability and Intelligent Booking",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"npm run start:server\" \"npm run start:client\"",
    "start": "npm run dev",
    "install:server": "npm --prefix server install",
    "install:client": "npm --prefix client install",
    "install-all": "npm run install:server && npm run install:client",
    "start:server": "npm --prefix server start",
    "start:client": "npm --prefix client run dev",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "seed": "npm --prefix server run seed",
    "test:server": "npm --prefix server test"
  },
  "keywords": [
    "smart-campus",
    "mern",
    "resource-booking",
    "real-time",
    "conflict-detection",
    "full-stack"
  ],
  "author": "Full Stack Development Project",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^10.0.6",
    "vite": "^8.3.4"
  }
}
